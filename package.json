{
  "name": "5xl",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-build": "opennextjs-cloudflare build",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "lint": "eslint",
    "seed": "node --env-file=.env.local scripts/seed.mjs",
    "seed:home": "node --env-file=.env.local scripts/seed-home.mjs",
    "seed:admin": "node --env-file=.env.local scripts/seed-admin.mjs",
    "make-admin": "node --env-file=.env.local scripts/make-admin.mjs",
    "import:blogs": "node --env-file=.env.local scripts/import-blogs.mjs",
    "categorize:blogs": "node --env-file=.env.local scripts/categorize-blogs.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.7.1",
    "@opennextjs/cloudflare": "^1.20.16",
    "@tanstack/react-query": "^5.101.4",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.28.0",
    "mongoose": "^9.9.1",
    "motion": "^12.43.0",
    "next": "^16.4.6",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.84.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "three": "^0.181.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.181.0",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.160.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261110.1": true,
    "unrs-resolver@1.12.2": true,
    "fsevents@2.3.3": true
  }
}
