{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "5xl",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  // nodejs_compat enables node:net / node:tls, required by the MongoDB driver
  // (mongoose 9) at compat dates >= 2025-03-20.
  "compatibility_flags": ["nodejs_compat"],
  // esbuild's keep_names injects __name() wrappers; next-themes stringifies its
  // init function into an inline <script>, where __name is undefined and throws
  // ("__name is not defined", theme flashes). Disabling keep_names fixes it.
  "keep_names": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Cloudflare D1 (SQLite) — the application database (Drizzle ORM).
  // For local dev the id can be any string; replace it with the real id from
  // `wrangler d1 create fivexl` before the first `--remote` command / deploy.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fivexl",
      "database_id": "e270df69-1887-4946-a38c-4b01b3d7ac47",
      "migrations_dir": "drizzle"
    }
  ],
  // R2 bucket for admin-uploaded product / CMS media, served via /api/media/<key>.
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "5xl-media"
    }
  ],
  "observability": {
    "enabled": true
  }
}
